# ── Base de datos (SQL Server) ────────────────────────────────────────────────
DB_SERVER=localhost          # IP o nombre del servidor SQL Server
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=tu_password_aqui
DB_NAME=gcm_tickets

# ── Servidor Node.js ──────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
SESSION_SECRET=cambia_esto_por_una_cadena_aleatoria_larga
BCRYPT_ROUNDS=12
ADMIN_PASSWORD=admin123

# ── Email (opcional — para notificaciones) ────────────────────────────────────
# Usa una "Contraseña de aplicación" de Google, NO tu contraseña normal.
# Generarla en: myaccount.google.com → Seguridad → Contraseñas de aplicaciones
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GCM Tickets <noreply@gcm.com>"
SMTP_CC=                     # Correo adicional en copia en cada notificacion (opcional)

# ── URL de la app (opcional) ──────────────────────────────────────────────────
# Solo si tienes dominio o IP fija. Si se deja vacío, el sistema detecta la IP automáticamente.
APP_URL=
