# NEXT_PUBLIC_API_URL queda sin definir a propósito: sin ella, el cliente
# arma la URL de la API a partir del host desde el que se accede a esta
# página (ver lib/api.ts) — así funciona igual en localhost, por IP de LAN
# (celular) o en un dominio real. Solo defínela si el backend vive en un
# dominio/puerto distinto al que "adivinaría" ese cálculo automático.
# NEXT_PUBLIC_API_URL=http://localhost:8080/api
# Debe coincidir con PORT en api/.env.
NEXT_PUBLIC_API_PORT=8080

# Puerto en el que escucha este frontend (Next.js). Debe coincidir con
# WEB_PORT en api/.env — ese valor es el que arma la URL del QR de "subir
# desde celular" y los links de los correos de notificación.
# OJO: Next.js NO lee esta variable de aquí para elegir su propio puerto —
# .env.local se carga después de que el CLI ya decidió en qué puerto
# escuchar. Para que el puerto realmente cambie, PORT debe ir como variable
# de entorno real del proceso (ver start-web.bat / ecosystem.config.js).
# Se deja aquí también por consistencia y porque sí es la que ve el código
# de la app en tiempo de ejecución (ej. cualquier lógica server-side que
# lea process.env.PORT).
PORT=8081
