# ── Base de datos (SQL Server) ────────────────────────────────────────────────
DB_SERVER=localhost          # IP o nombre del servidor SQL Server
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=tu_password_aqui
DB_NAME=gcm_tickets

# ── Servidor Node.js ──────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
SESSION_SECRET=cambia_esto_por_una_cadena_aleatoria_larga
BCRYPT_ROUNDS=12
ADMIN_PASSWORD=admin123

# ── Frontend Next.js ────────────────────────────────────────────────────────────
# Puerto donde corre "web/" (Next.js). El backend acepta peticiones de
# cualquier origen (LAN, no hay un único dominio fijo), así que no hace falta
# configurar CORS por separado.
WEB_PORT=3001
# URL pública del frontend (opcional) — usada por el QR de "subir desde
# celular" y por los links de los correos de notificación. Solo cámbiala si
# tienes dominio/IP fija para "web/"; si se deja vacío, se arma con la IP LAN
# detectada de esta máquina + WEB_PORT.
WEB_APP_URL=

# ── Email (opcional — para notificaciones) ────────────────────────────────────
# Usa una "Contraseña de aplicación" de Google, NO tu contraseña normal.
# Generarla en: myaccount.google.com → Seguridad → Contraseñas de aplicaciones
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GCM Tickets <noreply@gcm.com>"
SMTP_CC=                     # Correos en copia en cada notificacion, separados por coma (opcional)
                             # Ejemplo: correo1@empresa.com,correo2@empresa.com
